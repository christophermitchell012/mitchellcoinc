---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ site.url }}/</loc>
    {% assign homepage = site.pages | where: 'url', '/' | first %}
    <lastmod>{{ homepage.last_modified_at | date: '%Y-%m-%d' }}</lastmod>
  </url>
  <url>
    <loc>{{ site.url }}/blog/</loc>
    {% assign blog_page = site.pages | where: 'url', '/blog/' | first %}
    {% assign blog_modified_date = blog_page.last_modified_at %}
    {% assign blog_modified = blog_modified_date | date: '%s' | plus: 0 %}
    {% for post in site.posts %}
      {% assign post_modified = post.last_modified_at | default: post.date | date: '%s' | plus: 0 %}
      {% if post_modified > blog_modified %}
        {% assign blog_modified = post_modified %}
        {% assign blog_modified_date = post.last_modified_at | default: post.date %}
      {% endif %}
    {% endfor %}
    <lastmod>{{ blog_modified_date | date_to_xmlschema }}</lastmod>
  </url>
  {% for post in site.posts %}
  <url>
    <loc>{{ site.url }}{{ post.url }}</loc>
    <lastmod>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</lastmod>
  </url>
  {% endfor %}
  {% for file in site.static_files %}
  {% assign map_prefix = file.path | slice: 0, 6 %}
  {% if map_prefix == '/maps/' and file.extname == '.html' and file.name != '404.html' %}
  <url><loc>{{ site.url }}{% if file.name == 'index.html' %}/maps/{% else %}{{ file.path }}{% endif %}</loc><lastmod>{{ site.data.map_lastmod[file.path] }}</lastmod></url>
  {% endif %}
  {% endfor %}
</urlset>
